# ==============================================================================
# AuraStream Cinema - Environment Variables Configuration
# ==============================================================================
# Salin file ini menjadi .env pada environment lokal atau isi pada Dashboard Vercel:
# Project Settings > Environment Variables

# 1. Firebase Web Client Configuration
# Dapatkan dari: Firebase Console > Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 2. Administrator Configuration
# Sesuai instruksi keamanan, akun ini memiliki hak CRUD dan akses /admin
VITE_ADMIN_EMAIL=cristiandwihariantoro@gmail.com

# 3. Optional AI Studio / Deployment URLs
APP_URL="https://your-vercel-domain.vercel.app"
